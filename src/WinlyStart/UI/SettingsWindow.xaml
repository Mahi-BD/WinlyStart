<Window x:Class="WinlyStart.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winly Start settings" Width="980" SizeToContent="Height" MinWidth="900"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Background="{DynamicResource Dlg.Bg}" Foreground="{DynamicResource Dlg.Text}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource DlgButton}"/>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DlgSwitch}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DlgComboBox}"/>
        <Style TargetType="Slider" BasedOn="{StaticResource DlgSlider}"/>
        <Style TargetType="Border" BasedOn="{StaticResource DlgCard}"/>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DlgBody}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="28,22,28,12">
            <Image Source="pack://application:,,,/Assets/WinlyStart.png" Width="40" Height="40" Margin="0,0,14,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" Style="{StaticResource DlgH1}"/>
                <TextBlock Text="Winly Start · the Windows 10 Start menu on Windows 11" Style="{StaticResource DlgCaption}"/>
            </StackPanel>
        </StackPanel>

        <!-- two columns so everything fits without scrolling -->
        <Grid Grid.Row="1" Margin="28,0,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- left column -->
            <StackPanel Grid.Column="0">
                <Border>
                    <StackPanel>
                        <TextBlock Text="Replace the Windows 11 Start menu" Style="{StaticResource DlgH2}"/>
                        <CheckBox x:Name="WinKey" Content="Windows key and Ctrl+Esc open Winly Start"/>
                        <CheckBox x:Name="StartButton" Content="Clicking the Start button opens Winly Start"/>
                        <CheckBox x:Name="SuppressMenu" Content="Keep the Windows 11 Start menu closed"
                                  ToolTip="If the Windows 11 menu still appears (touch, an administrator window had the focus, a dropped hook), close it at once and open Winly Start instead"/>
                        <CheckBox x:Name="Autostart" Content="Start with Windows (current user only)"/>
                        <TextBlock Text="Registers a sign-in task for your user in Task Scheduler, so the menu is ready before the desktop's delayed startup apps. Removed when you untick this or uninstall." Style="{StaticResource DlgCaption}"/>
                    </StackPanel>
                </Border>

                <Border>
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource DlgH2}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,6"/>
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Margin="0,6" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Follow Windows"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Dark"/>
                            </ComboBox>
                            <TextBlock Grid.Row="1" Text="Tile columns" VerticalAlignment="Center" Margin="0,6"/>
                            <ComboBox x:Name="ColumnsBox" Grid.Row="1" Grid.Column="1" Margin="0,6" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="3 medium tiles (6 units)"/>
                                <ComboBoxItem Content="4 medium tiles (8 units)"/>
                            </ComboBox>
                            <TextBlock Grid.Row="2" Text="Menu height" VerticalAlignment="Center" Margin="0,6"/>
                            <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,6">
                                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding ElementName=HeightSlider, Path=Value, StringFormat={}{0:0} px}"/>
                                <Slider x:Name="HeightSlider" Minimum="480" Maximum="1000" TickFrequency="20" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </DockPanel>
                            <TextBlock Grid.Row="3" Text="Group spacing" VerticalAlignment="Center" Margin="0,6"/>
                            <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,6"
                                       ToolTip="Space between one tile group and the next group's name">
                                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                                           Text="{Binding ElementName=GapSlider, Path=Value, StringFormat={}{0:0} px}"/>
                                <Slider x:Name="GapSlider" Minimum="0" Maximum="96" TickFrequency="4" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </DockPanel>
                        </Grid>
                        <CheckBox x:Name="AtCorner" Content="Always open at the screen corner" Margin="0,10,0,4"/>
                        <TextBlock Text="Off: the menu follows your taskbar — in the middle of the screen when Start is centred, at the corner when Start is on the left. You can also resize the menu by dragging its top-right corner." Style="{StaticResource DlgCaption}"/>
                    </StackPanel>
                </Border>

                <Border>
                    <StackPanel>
                        <TextBlock Text="App list" Style="{StaticResource DlgH2}"/>
                        <CheckBox x:Name="Recent" Content="Show “Recently added”"/>
                        <CheckBox x:Name="MostUsed" Content="Show “Most used”"/>
                        <CheckBox x:Name="Trim" Content="Trim memory when the menu is hidden"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- right column -->
            <StackPanel Grid.Column="2">
                <Border>
                    <StackPanel>
                        <TextBlock Text="Account picture" Style="{StaticResource DlgH2}"/>
                        <DockPanel>
                            <Ellipse x:Name="ProfilePreview" DockPanel.Dock="Left" Width="64" Height="64" Margin="0,0,16,0"
                                     Stroke="{DynamicResource Dlg.ControlBorder}" StrokeThickness="1">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="ProfileBrush" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ProfileCaption" Style="{StaticResource DlgCaption}" Margin="0,0,0,8"
                                           Text="Shown on the user button in the left rail."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Choose picture…" MinWidth="0" Padding="12,0" Margin="0,0,8,0" Click="ChoosePicture_Click"/>
                                    <Button Content="Use Windows picture" MinWidth="0" Padding="12,0" Click="ResetPicture_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border>
                    <StackPanel>
                        <TextBlock Text="Icons on the left rail" Style="{StaticResource DlgH2}"/>
                        <TextBlock Text="Choose which shortcuts appear beside the app list." Style="{StaticResource DlgCaption}" Margin="0,0,0,6"/>
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="RailDocuments" Content="Documents"/>
                            <CheckBox x:Name="RailDownloads" Content="Downloads"/>
                            <CheckBox x:Name="RailMusic" Content="Music"/>
                            <CheckBox x:Name="RailPictures" Content="Pictures"/>
                            <CheckBox x:Name="RailVideos" Content="Videos"/>
                            <CheckBox x:Name="RailNetwork" Content="Network"/>
                            <CheckBox x:Name="RailPersonal" Content="Personal folder"/>
                            <CheckBox x:Name="RailExplorer" Content="File Explorer"/>
                            <CheckBox x:Name="RailSettings" Content="Settings"/>
                            <CheckBox x:Name="RailCalendar" Content="Calendar" ToolTip="Adds a calendar button that opens the calendar"/>
                        </UniformGrid>
                        <CheckBox x:Name="RailQuickPower" Content="Sleep / Shut down / Hibernate at the top" Margin="0,4,0,0"
                                  ToolTip="Hibernate shows only when Windows has hibernation enabled"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource DlgCaption}" Margin="4,2,4,0"
                           Text="Winly Start never modifies Windows. Quit it from the tray icon and the Windows 11 Start menu is back instantly."/>
            </StackPanel>
        </Grid>

        <!-- footer -->
        <Border Grid.Row="2" Background="{DynamicResource Dlg.Card}" BorderBrush="{DynamicResource Dlg.Border}"
                BorderThickness="0,1,0,0" CornerRadius="0" Padding="28,14" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Export…" Margin="0,0,10,0" Click="Export_Click"
                            ToolTip="Save the tile layout (groups, sizes, positions), your added programs, files and websites, the menu size and every setting to a file"/>
                    <Button Content="Import…" Margin="0,0,14,0" Click="Import_Click"
                            ToolTip="Restore a layout and settings from an exported file"/>
                    <TextBlock x:Name="BackupStatus" Style="{StaticResource DlgCaption}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button Content="Save" Style="{StaticResource DlgPrimaryButton}" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
