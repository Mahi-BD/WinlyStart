<Window x:Class="WinlyStart.UI.StartMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:WinlyStart.UI"
        Title="Winly Start" Width="648" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True" WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource Rs.Text}"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ui:InverseBoolToVisibilityConverter x:Key="BoolToVisInverse"/>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource AutoHideScroll}"/>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource Win10ContextMenu}"/>
        <Style TargetType="MenuItem" BasedOn="{StaticResource Win10MenuItem}"/>
        <Style TargetType="Separator" BasedOn="{StaticResource Win10Separator}"/>

        <!-- ───────── app list rows ───────── -->
        <DataTemplate DataType="{x:Type ui:HeaderRow}">
            <Border Height="36" Background="Transparent" MouseLeftButtonUp="Header_Click">
                <TextBlock x:Name="Txt" Text="{Binding Text}" Margin="12,0" VerticalAlignment="Center" FontSize="14"
                           Foreground="{DynamicResource Rs.Text}" FontWeight="SemiBold"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLetter}" Value="True">
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Rs.Header}"/>
                    <Setter TargetName="Txt" Property="FontWeight" Value="Normal"/>
                    <Setter TargetName="Txt" Property="FontSize" Value="16"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:AppRow}">
            <Border Height="36" Background="Transparent" MouseLeftButtonUp="App_Click">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Binding PinText}" Click="Pin_Click"/>
                        <MenuItem Header="More" Visibility="{Binding CanRunAsAdmin, Converter={StaticResource BoolToVis}}">
                            <MenuItem Header="Run as administrator" Click="RunAsAdmin_Click"/>
                            <MenuItem Header="Open file location" Click="OpenLocation_Click"/>
                        </MenuItem>
                        <MenuItem Header="Edit…" Click="RowEdit_Click"
                                  Visibility="{Binding App.IsCustom, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Uninstall" Click="Uninstall_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Orientation="Horizontal" Margin="{Binding IndentMargin}">
                    <Grid Width="24" Height="24" VerticalAlignment="Center">
                        <!-- default app glyph whenever the shell gives us no icon (or it hasn't loaded yet) -->
                        <TextBlock Text="&#xECAA;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Rs.TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding App.Icon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding App.Icon}" Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock Text="{Binding App.Name}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:FolderRow}">
            <Border Height="36" Background="Transparent" MouseLeftButtonUp="Folder_Click">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="24"
                                   TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Chevron}" FontFamily="{StaticResource Rs.Glyphs}" FontSize="10"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type ui:ExpandRow}">
            <Border Height="36" Background="Transparent" MouseLeftButtonUp="Expand_Click">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Chevron}" FontFamily="{StaticResource Rs.Glyphs}" FontSize="12" Width="24"
                                   TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Text}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ───────── tiles ───────── -->
        <DataTemplate DataType="{x:Type ui:TileVm}">
            <Border x:Name="Tile" Width="{Binding Width}" Height="{Binding Height}" Background="{DynamicResource Rs.Accent}"
                    BorderThickness="2" BorderBrush="Transparent" RenderTransformOrigin="0.5,0.5" ToolTip="{Binding Name}"
                    MouseLeftButtonDown="Tile_MouseDown" MouseMove="Tile_MouseMove" MouseLeftButtonUp="Tile_MouseUp">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Unpin from Start" Click="Unpin_Click"/>
                        <MenuItem Header="Resize">
                            <MenuItem Header="Small" Tag="Small" Click="Resize_Click"/>
                            <MenuItem Header="Medium" Tag="Medium" Click="Resize_Click"/>
                            <MenuItem Header="Wide" Tag="Wide" Click="Resize_Click"/>
                            <MenuItem Header="Large" Tag="Large" Click="Resize_Click"/>
                        </MenuItem>
                        <MenuItem Header="More" Visibility="{Binding CanRunAsAdmin, Converter={StaticResource BoolToVis}}">
                            <MenuItem Header="Run as administrator" Click="TileRunAsAdmin_Click"/>
                            <MenuItem Header="Open file location" Click="TileOpenLocation_Click"/>
                        </MenuItem>
                        <MenuItem Header="{Binding LiveMenuText}" Click="LiveToggle_Click"
                                  Visibility="{Binding CanBeLive, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Edit…" Click="TileEdit_Click"
                                  Visibility="{Binding App.IsCustom, Converter={StaticResource BoolToVis}}"/>
                        <MenuItem Header="Uninstall" Click="TileUninstall_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid ClipToBounds="True">
                    <!-- icon face -->
                    <Grid x:Name="IconFace">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="IconSlide"/>
                        </Grid.RenderTransform>
                        <TextBlock Text="&#xECAA;" FontFamily="{StaticResource Rs.Glyphs}"
                                   FontSize="{Binding ImageWidth}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Rs.AccentText}" Opacity="0.75">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image Source="{Binding Image}" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <!-- live face: slides up over the icon (Windows 10 style). Parked below the clip until shown. -->
                    <Grid x:Name="LiveFace" IsHitTestVisible="False" Opacity="0">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="LiveSlide" Y="220"/>
                        </Grid.RenderTransform>
                        <Image Source="{Binding LiveImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding LiveHasImage, Converter={StaticResource BoolToVis}}"/>
                        <!-- bottom margin reserves the strip the tile name sits in, so the two never collide -->
                        <StackPanel Margin="10,7,10,26" VerticalAlignment="Top"
                                    Visibility="{Binding LiveHasImage, Converter={StaticResource BoolToVisInverse}}">
                            <!-- empty parts collapse so they don't reserve a line and push the rest into the name -->
                            <TextBlock Text="{Binding LiveTitle}" FontSize="12" Foreground="{DynamicResource Rs.AccentText}" Opacity="0.9"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LiveTitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- DownOnly viewbox: long times/dates shrink to fit instead of being cut off -->
                            <Viewbox StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left"
                                     MaxHeight="{Binding LiveBigSize}" Margin="0,-2,0,0">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LiveBig}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <TextBlock Text="{Binding LiveBig}" FontSize="{Binding LiveBigSize}" FontWeight="Light"
                                           Foreground="{DynamicResource Rs.AccentText}"/>
                            </Viewbox>
                            <TextBlock Text="{Binding LiveSub}" FontSize="11" Foreground="{DynamicResource Rs.AccentText}" Opacity="0.9"
                                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="28" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LiveSub}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <Border Height="26" VerticalAlignment="Bottom" IsHitTestVisible="False"
                            Visibility="{Binding LiveHasImage, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#99000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Rs.AccentText}" Margin="8,0,8,6"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Rs.TileBorder}"/>
                </Trigger>
                <!-- flip between faces -->
                <DataTrigger Binding="{Binding ShowLive}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LiveSlide" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="LiveFace" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetName="IconSlide" Storyboard.TargetProperty="Y" To="-60" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="IconFace" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LiveSlide" Storyboard.TargetProperty="Y" To="220" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="LiveFace" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35"/>
                                <DoubleAnimation Storyboard.TargetName="IconSlide" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="IconFace" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.75"/>
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Rs.TileBorderPressed}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="TileContainer" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding X}"/>
            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Panel.ZIndex" Value="100"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type ui:TileGroupVm}">
            <!-- 24 px under the last tile row, then the 40 px header: a fixed 64 px between one group's
                 tiles and the next, whatever row the last tile ends on (user: "a fixed gap"). -->
            <StackPanel Margin="0,0,0,24">
                <!-- Windows 10 group header. Normally plain text (not an edit field); click it to rename
                     and it becomes a real text box. Drag it to move the whole group. -->
                <Grid Height="36" Margin="0,0,0,4" HorizontalAlignment="Left" MinWidth="220">
                    <Border Background="Transparent" Cursor="Hand" ToolTip="Click to rename · drag to move this group"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverse}}"
                            MouseLeftButtonDown="GroupHeader_MouseDown" MouseMove="GroupHeader_MouseMove"
                            MouseLeftButtonUp="GroupHeader_MouseUp">
                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename group" Click="GroupRename_Click"/>
                                <MenuItem Header="Remove group" Click="GroupRemove_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                            <TextBlock Text="{Binding Name}" Margin="4,0,0,0" FontSize="14"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Rs.Text}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Name group" Margin="4,0,0,0" FontSize="14" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Rs.TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Name}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <TextBox x:Name="GroupNameBox" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                             Padding="6,0" Background="{DynamicResource Rs.Search}"
                             BorderBrush="{DynamicResource Rs.Accent}" BorderThickness="2"
                             Foreground="{DynamicResource Rs.Text}" CaretBrush="{DynamicResource Rs.Text}"
                             FontSize="14" VerticalContentAlignment="Center" MaxLength="64"
                             LostFocus="GroupName_LostFocus" KeyDown="GroupName_KeyDown"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Tiles}" ItemContainerStyle="{StaticResource TileContainer}"
                              Width="{Binding PixelWidth}" Height="{Binding PixelHeight}" HorizontalAlignment="Left"
                              Background="Transparent" Tag="{Binding}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="Transparent"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Background="#01000000" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="24"/>
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition x:Name="ListCol" Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ───────── left rail ───────── -->
        <Border Grid.Column="0" Background="{DynamicResource Rs.Rail}">
            <DockPanel>
                <Button DockPanel.Dock="Top" Style="{StaticResource RailButton}" Content="&#xE700;" Click="Hamburger_Click" ToolTip="Expand"/>
                <!-- quick power: Sleep / Shut down / Hibernate (Settings › rail) -->
                <StackPanel x:Name="QuickPower" DockPanel.Dock="Top">
                    <Button x:Name="SleepButton" Style="{StaticResource RailButton}" Content="&#xE708;" Click="Sleep_Click" ToolTip="Sleep"/>
                    <Button Style="{StaticResource RailButton}" Content="&#xE7E8;" Click="ShutDown_Click" ToolTip="Shut down"/>
                    <Button x:Name="HibernateButton" Style="{StaticResource RailButton}" Click="Hibernate_Click" ToolTip="Hibernate">
                        <Grid>
                            <TextBlock Text="&#xE708;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE7E8;" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10"/>
                        </Grid>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="UserButton" Style="{StaticResource RailButton}" Click="User_Click">
                        <Grid>
                            <TextBlock x:Name="UserGlyph" Text="&#xE77B;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse x:Name="UserPicture" Width="24" Height="24" Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="UserPictureBrush" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Button>
                    <ItemsControl x:Name="RailList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource RailButton}" Content="{Binding Glyph}"
                                        ToolTip="{Binding Tooltip}" Click="RailItem_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="PowerButton" Style="{StaticResource RailButton}" Content="&#xE7E8;" Click="Power_Click" ToolTip="Power"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <!-- ───────── app list ───────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Border x:Name="SearchBar" Visibility="Collapsed" Margin="8,8,8,0" Height="32"
                    Background="{DynamicResource Rs.Search}" BorderThickness="2" BorderBrush="{DynamicResource Rs.Accent}">
                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="6,0"
                         Foreground="{DynamicResource Rs.Text}" CaretBrush="{DynamicResource Rs.Text}"
                         VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
            </Border>
            <ListBox x:Name="AppList" Grid.Row="1" Style="{StaticResource AppListBox}" Margin="0,8,0,0"
                     SelectionMode="Single" KeyDown="AppList_KeyDown"
                     FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent"/>
            <Border x:Name="JumpGrid" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource Rs.Flyout}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="JumpPanel" Margin="8,16" Width="240"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ───────── tiles ───────── -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="8,8,4,0" PanningMode="VerticalOnly" Focusable="False" Background="Transparent">
            <ScrollViewer.ContextMenu>
                <!-- right-click on empty board space -->
                <ContextMenu>
                    <MenuItem Header="Add program or file…" Click="AddFile_Click"/>
                    <MenuItem Header="Add website…" Click="AddWebsite_Click"/>
                    <Separator/>
                    <MenuItem Header="New group" Click="NewGroup_Click"/>
                    <Separator/>
                    <MenuItem Header="Settings…" Click="MenuSettings_Click"/>
                    <MenuItem Header="About Winly Start" Click="MenuAbout_Click"/>
                </ContextMenu>
            </ScrollViewer.ContextMenu>
            <ItemsControl x:Name="TileGroupsControl" Margin="4,0,0,0" Focusable="False"/>
        </ScrollViewer>

        <!-- accent line showing where a dragged group will land -->
        <Rectangle x:Name="GroupInsertLine" Grid.Column="2" Height="3" Fill="{DynamicResource Rs.Accent}" RadiusX="1.5" RadiusY="1.5"
                   VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="12,0,12,0" Visibility="Collapsed"
                   IsHitTestVisible="False" Panel.ZIndex="80"/>

        <!-- divider between the app list and the tiles: invisible until hovered, drag to change the list width -->
        <Thumb x:Name="ListGrip" Grid.Column="1" Width="8" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,-4,0"
               Cursor="SizeWE" Panel.ZIndex="92" Focusable="False" ToolTip="Drag to resize the app list"
               DragStarted="Grip_DragStarted" DragDelta="ListGrip_DragDelta" DragCompleted="Grip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="Bar" Width="3" Margin="0,10" HorizontalAlignment="Center" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource Rs.Accent}" Opacity="0"/>
                    </Grid>
                    <!-- plain state, no storyboards: the bar shows exactly while hovered or dragged. The
                         earlier fade-in/out animations left it stuck on after a drag (the drag's "to 1"
                         animation held the value and nothing ran when the drag ended). -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- ───────── expanded rail (hamburger): same items as the icon rail, with labels ───────── -->
        <Border x:Name="RailFlyout" Grid.ColumnSpan="2" Width="248" HorizontalAlignment="Left" Visibility="Collapsed"
                Background="{DynamicResource Rs.Flyout}">
            <DockPanel>
                <Button DockPanel.Dock="Top" Style="{StaticResource FlyoutItem}" Click="Hamburger_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                        <TextBlock Text="START" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel x:Name="QuickPowerFlyout" DockPanel.Dock="Top">
                    <Button x:Name="SleepFlyoutButton" Style="{StaticResource FlyoutItem}" Click="Sleep_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE708;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                            <TextBlock Text="Sleep" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlyoutItem}" Click="ShutDown_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                            <TextBlock Text="Shut down" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HibernateFlyoutButton" Style="{StaticResource FlyoutItem}" Click="Hibernate_Click">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="48">
                                <TextBlock Text="&#xE708;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,2"/>
                            </Grid>
                            <TextBlock Text="Hibernate" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource FlyoutItem}" Click="User_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                            <TextBlock x:Name="UserNameText" Text="User" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ItemsControl x:Name="RailFlyoutList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource FlyoutItem}" Click="RailItem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16"
                                                   Width="48" TextAlignment="Center"/>
                                        <TextBlock Text="{Binding Tooltip}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource FlyoutItem}" Click="Power_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                            <TextBlock Text="Power" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>

        <!-- ───────── resize grips (menu is bottom-left anchored, grows up/right) ───────── -->
        <Thumb x:Name="TopGrip" Grid.ColumnSpan="3" Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch"
               Cursor="SizeNS" Panel.ZIndex="90" Opacity="0" Background="Transparent"
               DragStarted="Grip_DragStarted" DragDelta="TopGrip_DragDelta" DragCompleted="Grip_DragCompleted"/>
        <Thumb x:Name="RightGrip" Grid.ColumnSpan="3" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Cursor="SizeWE" Panel.ZIndex="90" Opacity="0" Background="Transparent"
               DragStarted="Grip_DragStarted" DragDelta="RightGrip_DragDelta" DragCompleted="Grip_DragCompleted"/>
        <Thumb x:Name="CornerGrip" Grid.ColumnSpan="3" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Top"
               Cursor="SizeNESW" Panel.ZIndex="96" ToolTip="Drag to resize"
               DragStarted="Grip_DragStarted" DragDelta="CornerGrip_DragDelta" DragCompleted="Grip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Stroke="{DynamicResource Rs.TextSecondary}" StrokeThickness="1" SnapsToDevicePixels="True"
                              Data="M17,3 L3,17  M17,8 L8,17  M17,13 L13,17" Opacity="0.9"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- hairline outline: separates the menu from the taskbar and the desktop -->
        <Border x:Name="Outline" Grid.ColumnSpan="3" BorderBrush="{DynamicResource Rs.Divider}" BorderThickness="1"
                IsHitTestVisible="False" Panel.ZIndex="95"/>

        <!-- ───────── flyouts ───────── -->
        <Popup x:Name="PowerFlyout" PlacementTarget="{Binding ElementName=PowerButton}" Placement="Right" VerticalOffset="-96"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Rs.Flyout}" BorderBrush="{DynamicResource Rs.Divider}" BorderThickness="1" MinWidth="160">
                <StackPanel>
                    <Button Style="{StaticResource FlyoutItem}" Click="Sleep_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE708;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                            <TextBlock Text="Sleep" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlyoutItem}" Click="ShutDown_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                            <TextBlock Text="Shut down" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlyoutItem}" Click="Restart_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                            <TextBlock Text="Restart" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="UserFlyout" PlacementTarget="{Binding ElementName=UserButton}" Placement="Right" VerticalOffset="-96"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource Rs.Flyout}" BorderBrush="{DynamicResource Rs.Divider}" BorderThickness="1" MinWidth="220">
                <StackPanel>
                    <Button Style="{StaticResource FlyoutItem}" Click="AccountSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                            <TextBlock Text="Change account settings" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlyoutItem}" Click="Lock_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                            <TextBlock Text="Lock" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlyoutItem}" Click="SignOut_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE748;" FontFamily="{StaticResource Rs.Glyphs}" FontSize="16" Width="48" TextAlignment="Center"/>
                            <TextBlock Text="Sign out" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
