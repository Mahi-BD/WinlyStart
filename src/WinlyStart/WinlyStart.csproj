<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WinlyStart</RootNamespace>
    <AssemblyName>WinlyStart</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/WinlyStart.ico</ApplicationIcon>
    <!-- Version info is stamped into the PE resources. Code-signing programs (the Microsoft Store
         and the SignPath Foundation both) require a signed binary to carry a product name and a
         version, so keep every field below populated. -->
    <Version>1.5.2</Version>
    <Authors>Winly Start contributors</Authors>
    <Company>Winly Start contributors</Company>
    <Product>Winly Start</Product>
    <AssemblyTitle>Winly Start</AssemblyTitle>
    <Description>The Windows 10 Start menu, back on Windows 11.</Description>
    <Copyright>© 2026 Winly Start contributors. MIT License.</Copyright>
    <!-- lets the project compile on Linux/macOS CI boxes; it only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- memory / size discipline -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/WinlyStart.ico" />
    <Resource Include="Assets/WinlyStart.png" />
    <Resource Include="Assets/calendar.png" />
  </ItemGroup>

</Project>
